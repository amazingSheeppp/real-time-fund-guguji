<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="48dp"
    android:paddingEnd="24dp"
    android:paddingBottom="48dp">

    <!-- 水墨搜索图腾徽记 -->
    <ImageView
        android:id="@+id/iv_empty"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:contentDescription="@string/search_empty_title"
        android:src="@drawable/ic_search_empty_ink" />

    <!-- 衬线大标题 (保留 tv_empty ID 兼容既有调用) -->
    <TextView
        android:id="@+id/tv_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="serif"
        android:text="@string/search_initial_title"
        android:textColor="@color/ink"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- 意境副说明文案 -->
    <TextView
        android:id="@+id/tv_empty_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="@string/search_initial_hint"
        android:textColor="@color/ink_faint"
        android:textSize="13sp" />

    <!-- 快捷清空重试按钮 (无结果时展示) -->
    <TextView
        android:id="@+id/btn_clear_search"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_btn_ink_outline"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:text="@string/search_empty_clear"
        android:textColor="@color/ink"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- 热门搜索推荐区 -->
    <LinearLayout
        android:id="@+id/layout_search_suggestions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_suggestions_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/search_hot_title"
            android:textColor="@color/ink_mid"
            android:textSize="12sp"
            android:letterSpacing="0.05" />

        <!-- 热门标签行 1 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tag_hs300"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_search_tag"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="沪深300"
                android:textColor="@color/ink"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tag_yfd"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_search_tag"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="易方达"
                android:textColor="@color/ink"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tag_nasdaq"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_search_tag"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="纳斯达克"
                android:textColor="@color/ink"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- 热门标签行 2 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tag_zg"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_search_tag"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="中概互联"
                android:textColor="@color/ink"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tag_dividend"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_search_tag"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="红利低波"
                android:textColor="@color/ink"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tag_gold"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_search_tag"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="黄金ETF"
                android:textColor="@color/ink"
                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
