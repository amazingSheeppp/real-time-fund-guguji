<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 墨水屏主题:中性灰,与 DESIGN_SPEC.md 一致 -->
    <style name="Base.Theme.Guguji" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/ink</item>
        <item name="colorOnPrimary">@color/card</item>
        <item name="colorPrimaryContainer">@color/ink_heavy</item>
        <item name="colorSecondary">@color/ink_mid</item>
        <item name="colorSurface">@color/card</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:windowBackground">@color/paper</item>
    </style>

    <style name="Theme.Guguji" parent="Base.Theme.Guguji" />

    <!-- 衬线标题(墨水屏纸书气质) -->
    <style name="TextAppearance.Guguji.SerifTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 方形 FAB(不用圆形) -->
    <style name="ShapeAppearance.Guguji.Square" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <!-- 水墨纸质卡片 Dialog 主题 -->
    <style name="Theme.Guguji.Dialog" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
    </style>

    <!-- 水墨底部抽屉面板主题 -->
    <style name="Theme.Guguji.BottomSheetDialog" parent="Theme.Material3.DayNight.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Guguji.BottomSheet</item>
    </style>

    <style name="Widget.Guguji.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <!-- 图表区间切换 chip:选中=焦墨实心,未选中=浅边清墨(对齐设计规范 5.4) -->
    <style name="Widget.Guguji.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/selector_chip_range_bg</item>
        <item name="android:textColor">@color/selector_chip_range_text</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipStrokeColor">@color/selector_chip_range_stroke</item>
        <item name="chipCornerRadius">6dp</item>
        <item name="chipMinHeight">30dp</item>
        <item name="chipEndPadding">10dp</item>
        <item name="chipStartPadding">10dp</item>
        <item name="android:textSize">12sp</item>
        <item name="closeIconVisible">false</item>
        <item name="checkedIconVisible">false</item>
    </style>

    <style name="Widget.Guguji.Chip.Range" parent="Widget.Guguji.Chip" />
</resources>
